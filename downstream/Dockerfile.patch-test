FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY downstream/ /bench/downstream/
COPY upstream.tar /bench/upstream.tar
ENV HOME=/tmp
USER 1000:1000
ENTRYPOINT ["python3", "/bench/downstream/verify_patch.py", "/bench/upstream.tar"]
