+        """Camera names may legitimately contain '@'. The parser must
+        rsplit on the rightmost '@<timestamp>' rather than naively
+        splitting on every '@', so a file like
+        ``back@foo@bar@<ts>.mp4`` is parsed as camera ``back@foo@bar``,
+        quality ``sub`` (M5 fix)."""
+        captured = []
